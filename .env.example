DATABASE_URL=postgres://liveo:liveo@localhost:5432/liveo

# Staff login. Comma separated email:password pairs for the MVP. Replace with SSO later.
# Comma separated username:password pairs. Usernames can be plain names, e.g. Abz:secret,Ant:secret
STAFF_USERS=admin:change-me
SESSION_SECRET=replace-with-32-plus-random-characters

# Region the loaders clip to. "london" or a comma separated list of local authority codes.
LIVEO_REGION=london

# Propalt REST API. The base URL and key come from your Propalt account.
PROPALT_API_BASE=
PROPALT_API_KEY=
# Header used to send the key. Change if your account uses a different scheme.
PROPALT_AUTH_HEADER=x-api-key

# Free government APIs that need a (free) key.
EPC_API_EMAIL=
EPC_API_KEY=
OFCOM_API_KEY=

# Stripe (stub works without keys)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Map style. OpenFreeMap needs no key.
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
